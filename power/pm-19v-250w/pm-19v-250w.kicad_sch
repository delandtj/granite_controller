	(text "Current limit: 67 mV min / 8 mOhm = 8.4 A peak per phase, ~14 A DC total." (exclude_from_sim no) (at 279.4 136.13 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "98d68d4b-aa77-419a-b9f3-281335f81df4"))
