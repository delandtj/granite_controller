	(text "C1-C8: 2.2 uF 100 V X7R 1210 (~1 uF left at 54 V). C20-C23: 22 uF 35 V X7R 1210." (exclude_from_sim no) (at 279.4 117.08 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "e8a21d3e-776c-407c-be3c-29cb1dff2cac"))
	(text "C24, C25: 100 uF 35 V solid polymer. No wet electrolytics (immersion)." (exclude_from_sim no) (at 279.4 120.89 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "f9c39bfd-195a-4a6e-89bc-a2d20e3924a4"))
	(text "Two-phase: VFB2 = INTVCC, RUN2 = RUN1, ITH2 / TRACK/SS2 to 1 nF. FREQ = GND: 200 kHz per phase." (exclude_from_sim no) (at 279.4 124.7 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "baed29f0-f06a-4583-9040-9f8b44e6abcc"))
	(text "DRVSET open: 10 V gate drive. NDRV = DRVCC (NDRV LDO unused). EXTVCC = VOUT once running." (exclude_from_sim no) (at 279.4 128.51 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "1e4533d0-ce3b-41c6-ba6e-e8031d900434"))
