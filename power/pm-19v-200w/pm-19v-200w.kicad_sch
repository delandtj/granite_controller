	(text "C1-C8: 2.2 uF 100 V X7R 1210 (~1 uF left at 54 V). C20-C23: 22 uF 35 V X7R 1210." (exclude_from_sim no) (at 279.4 117.08 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "805f6f15-6b8f-4d82-ad84-7b7c03399a3a"))
	(text "C24, C25: 100 uF 35 V solid polymer. No wet electrolytics (immersion)." (exclude_from_sim no) (at 279.4 120.89 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "a2ca4a65-6ca0-4a21-b6c5-fcb154c4c836"))
	(text "Two-phase: VFB2 = INTVCC, RUN2 = RUN1, ITH2 / TRACK/SS2 to 1 nF. FREQ = GND: 200 kHz per phase." (exclude_from_sim no) (at 279.4 124.7 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "01566f66-ef7c-4d63-9f1f-c8cac2216da8"))
	(text "DRVSET open: 10 V gate drive. NDRV = DRVCC (NDRV LDO unused). EXTVCC = VOUT once running." (exclude_from_sim no) (at 279.4 128.51 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "b46da9e7-a607-46ed-9180-dd16394ef728"))
	(text "PLLIN/SPREAD = GND: no sync, no spread spectrum. MODE = INTVCC: forced continuous." (exclude_from_sim no) (at 279.4 132.32 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "7fb70a8a-5e10-4883-bc88-f0535c0ea6c0"))
	(text "Current limit: 67 mV min / 8 mOhm = 8.4 A peak per phase, ~14 A DC total." (exclude_from_sim no) (at 279.4 136.13 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "de562ebc-0755-4e7b-bd49-413a4b18e471"))
	(text "UVLO 38.4 V / OVLO 62.7 V via R3-R5. RUN (J1.2) open = on, pulled low = off." (exclude_from_sim no) (at 279.4 139.94 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "125c8c31-6cbe-41c0-a72c-d83b228a816a"))
	(text "OV_KILL low above ~22.7 V, PGOOD high above ~17.3 V; comparators run from VAUX (VIN, 47k, 4.7 V zener)." (exclude_from_sim no) (at 279.4 143.75 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "79005253-7158-48f1-9716-5930b0364cd2"))
