# KiCad
*.kicad_sch.lck
*.kicad_pcb.lck
*.kicad_prl
*-backups/
fp-info-cache
_autosave-*
\#auto_saved_files\#
.history/
*.kicad_pro.lck

# Python
__pycache__/

# Generated fab outputs (tools/jlcfab.py)
fab/

# mdBook output (site/)
site/book/

# Per-board recovery tokens and passwords (secrets)
firmware/*recovery_token*

# Cargo build output
target/

# KiCad STEP exports and JLC fabrication-toolkit output (regenerable)
power/*/*.step
attic/power/*/*.step
power/*/production/
attic/power/*/production/

# kicad-mcp scratch (visual diffs, ERC reports, renders)
.kicad-mcp/
power/*/output/
attic/power/*/output/

# agent worktrees (Claude Code)
.claude/worktrees/

# mech: board STEP exports (regenerable), FreeCAD backups
mech/step/
*.FCBak

# KiCad Fabrication Toolkit plugin settings
fabrication-toolkit-options.json
