# Granite controller - ESP-IDF configuration defaults.
# Target is the ESP32-C6-WROOM-1-N8 (RISC-V, 8 MB flash).
# Signing/OTA-verification options are NOT here: see
# sdkconfig.defaults.signing (opt-in, needs a private key).

# --- flash ---------------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# --- partition table -----------------------------------------------------
# esp-idf-sys cannot point the ESP-IDF build at a partition CSV outside its
# own project dir (see its README, "Known limitations"), so the real table
# (partitions.csv) is applied by espflash at flash time with
# --partition-table. Pick the large single-app table here purely so the
# build-time size check has 1.5 MB of headroom.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# --- console -------------------------------------------------------------
# UART0 carries the 1-wire probe bus, so the console moves to the
# USB Serial/JTAG peripheral on the USB-C connector.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- radios off ----------------------------------------------------------
# The board is Ethernet only (W5500 over SPI) and submerged, so no radio
# is of any use (ADR 0001 component 27, "No radio").
#
# CONFIG_ESP_WIFI_ENABLED is a hidden symbol in ESP-IDF v5.5 (no prompt,
# `default y if SOC_WIFI_SUPPORTED`), so an assignment here is ignored by
# kconfgen and the component stays in the build. The radio is simply never
# initialised: `esp_wifi_init` is not called, so it allocates nothing, and
# what is left is flash the image does not execute. Dropping the component
# would take an ESP-IDF build-system escape hatch esp-idf-sys does not
# expose; the `wifi-dev` feature (bench only) still needs it.
#
# 802.15.4 *is* a visible symbol, and with it off its receive buffers and
# its task are not built at all.
CONFIG_BT_ENABLED=n
CONFIG_IEEE802154_ENABLED=n

# --- Ethernet (W5500 over SPI) -------------------------------------------
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y
CONFIG_ETH_SPI_ETHERNET_DM9051=n
CONFIG_ETH_SPI_ETHERNET_KSZ8851SNL=n

# --- lwIP ----------------------------------------------------------------
CONFIG_LWIP_IPV4=y
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_AUTOIP=y
# With AUTOIP on, the simple ARP check is unavailable (it depends on
# !LWIP_AUTOIP); use Address Conflict Detection instead.
CONFIG_LWIP_DHCP_DOES_ACD_CHECK=y
# lwIP starts AUTOIP alongside DHCP at the DISCOVER after this many
# unanswered ones, and keeps retrying DHCP underneath
# (LWIP_DHCP_AUTOIP_COOP). ESP-IDF's backoff (lwipopts.h,
# DHCP_REQUEST_BACKOFF_SEQUENCE) sends DISCOVERs at 0, 0.5, 1.5, 3.5, 7.5 s
# after link-up and then every 4 s, so N tries start AutoIP at
# 7.5 + 4 * (N - 4) s: 10 is 31.5 s, the "no lease within 30 s" of ADR 0001
# component 6. (It was 4 = 7.5 s, on the assumption of a 2 + 4 + 8 + 16 s
# backoff; a switch port that forwards ~4-8 s after link-up then put the
# DHCP answer right on AutoIP's start, rev C 2026-11-04.) Once an address
# is routable, platform/net.rs stops AutoIP (components/granite_lwip).
CONFIG_LWIP_AUTOIP_TRIES=10
CONFIG_LWIP_NETIF_LOOPBACK=y
CONFIG_LWIP_SO_RCVBUF=y
# Socket table: HTTPS (listener, control, 4 sessions), HTTP (listener,
# control, 2 sessions), MQTT, mDNS, Modbus (listener, max_conn 4) is
# about 16 at worst; the default 10 left Modbus two connections.
CONFIG_LWIP_MAX_SOCKETS=20
# SNTP server from DHCP option 42 (ADR component 6). Without this,
# esp_sntp_config_t::server_from_dhcp has nothing to read.
CONFIG_LWIP_DHCP_GET_NTP_SRV=y

# --- boot safety ---------------------------------------------------------
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# The bootloader's RTC watchdog (9 s) stays on into the app: a confirmed
# image switches it off at the top of main, an image on probation keeps
# it until it confirms (platform/ota.rs, "Hardware probation deadline").
# App-side only; the bootloader binary does not change.
CONFIG_BOOTLOADER_WDT_ENABLE=y
CONFIG_BOOTLOADER_WDT_DISABLE_IN_USER_CODE=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
# The summary API (`esp_core_dump_get_summary`, used by
# src/platform/coredump.rs for the `sys`/`coredump` event of ADR 0001
# component 27) copies the crashing image's ELF SHA-256 as a string of
# this many hex digits. The default is 9; the ADR reports 16.
CONFIG_APP_RETRIEVE_LEN_ELF_SHA=16

# --- HTTP server ---------------------------------------------------------
# The setup page and the JSON API are HTTPS only (ADR 0001 component 8);
# without this symbol esp-idf-svc does not even expose the certificate
# fields of its server Configuration. Added by the HTTP/API task.
CONFIG_ESP_HTTPS_SERVER_ENABLE=y

# --- TLS -----------------------------------------------------------------
# ECDSA P-256 for the device certificate and for app signature checks.
CONFIG_MBEDTLS_ECP_C=y
CONFIG_MBEDTLS_ECDH_C=y
CONFIG_MBEDTLS_ECDSA_C=y
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y
CONFIG_MBEDTLS_HARDWARE_SHA=y
# Writing the self-signed device certificate (ADR component 13) needs
# PEM output. MBEDTLS_X509_CREATE_C and MBEDTLS_X509_CRT_WRITE_C have no
# Kconfig symbol in ESP-IDF v5.5.5: they are defined unconditionally in
# components/mbedtls/port/include/mbedtls/esp_config.h, so this one line
# is all the certificate writer needs.
CONFIG_MBEDTLS_PEM_WRITE_C=y

# TLS record buffers on demand (ADR 0001 component 27). Without this
# every TLS session keeps a 16 KB receive and a 4 KB send buffer for as
# long as it lives; the broker session is idle most of the time, and it
# is always there. With it mbedTLS allocates a record buffer when a
# record is read or written and frees it afterwards. The price is an
# allocation per record, and a session that cannot get its buffer fails
# that read or write instead of failing at connect.
# FREE_CONFIG_DATA stays off: the HTTPS server reuses its certificate and
# key for every session, so they must outlive a handshake.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=n

# --- runtime -------------------------------------------------------------
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
# The default event loop task (`sys_evt`) runs esp_netif's and esp_eth's
# handlers as well as ours, including the IpEvent subscription of
# src/platform/net.rs. The default 2304 bytes left it 956 free on a rev C
# board (console `stacks`, 2026-11-04): 59 % used, and the deepest of
# those handlers is not ours to bound.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# uxTaskGetSystemState() is compiled only with configUSE_TRACE_FACILITY,
# and that is how the firmware reads per-task stack high-water marks
# (src/platform/tasks.rs, the console's `stacks` command and one log block
# 120 s after boot). Needed because `lto = true` inlines large
# constructors into caller frames, so a stack that was ample without LTO
# can overflow with it - the dispatcher did, on a rev C board.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# --- I2C -----------------------------------------------------------------
# Both buses use the ESP-IDF v5 I2C master driver (driver/i2c_master.h):
# the external bus is the LP I2C instance on GPIO6/7, which the legacy
# driver (driver/i2c.h) cannot address at all (see src/hw/ext_i2c.rs).
# The legacy driver is still *linked* into the image, because esp-idf-hal's
# i2c module references i2c_driver_delete whether or not the firmware calls
# it, and the legacy driver's startup constructor aborts the firmware when
# it finds the new driver linked alongside it. Nothing in the firmware
# calls the legacy API, so there is no real conflict and the check is
# skipped. If you ever do use esp_idf_hal::i2c::I2cDriver, remove this
# line again: the check would then be telling the truth.
CONFIG_I2C_SKIP_LEGACY_CONFLICT_CHECK=y

# --- app version -----------------------------------------------------------
# The app descriptor's version, which esp-idf-svc's OTA slot reader copies
# into a 24-character buffer. Left to ESP-IDF it is `git describe`
# (e.g. rev-c-usb4105-25-gf6b075d, 25 characters) and every slot read
# fails with ESP_ERR_INVALID_SIZE. build.rs checks that this equals the
# crate version and fits in 24 characters.
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="0.1.0"
