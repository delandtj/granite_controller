	(text "CAN link (ADR 0006 decision 9): MCP2518FD CAN FD controller on the W5500 SPI bus (GPIO19 SCLK / GPIO20 MOSI / GPIO21 MISO), nCS GPIO2, nINT GPIO3; TCAN1044V transceiver, STB on GPIO0."
		(exclude_from_sim no)
		(at 20.32 25.4 0)
		(effects
			(font
			(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "35623870-710a-5a5b-9f18-2b1f93716242")
	)
	(text "Not isolated: the controller ground is LINK_GND (link pins 3 / 4); its 12 V is AUX_12V (pins 5 / 6), OR-ed from every core."
		(exclude_from_sim no)
		(at 20.32 29.21 0)
		(effects
			(font
			(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bf3ef7fa-acb9-5f84-987f-9df3a68e17cd")
	)
	(text "MCP2518FD: SPI <= 17 MHz at SYSCLK 40 MHz (its own transactions; W5500 nCS GPIO18 stays). nINT push-pull after reset (IOCON.INTOD = 0), 10k pull-up holds it high before init. GPIO0 / GPIO1 / CLKO unused: firmware sets INT0 / INT1 as outputs."
		(exclude_from_sim no)
		(at 20.32 33.02 0)
		(effects
			(font
			(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d7d2b0d6-d56e-5785-b518-4eeed64b4456")
	)
	(text "Symbol: KiCad MCP2517FD-xSL (MCP2518FD is the pin-compatible successor, SOIC-14)."
		(exclude_from_sim no)
		(at 20.32 36.83 0)
		(effects
			(font
			(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9a1a29dd-1cc5-512f-9a1c-11973e8e0350")
	)
